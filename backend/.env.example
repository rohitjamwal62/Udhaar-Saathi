# Copy to .env
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.8


# Development only (needs DEBUG): print OTPs to this console / use the fake payment gateway.
OTP_SENDER=console
PAYMENT_GATEWAY=fake

# Real Razorpay (test mode first). Keep the secrets on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LIVE database = Neon. Copy the connection string from the Neon console (Connect). Required.
DATABASE_URL=
