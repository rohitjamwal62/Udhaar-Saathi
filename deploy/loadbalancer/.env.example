# Copy to .env (git-ignored) and fill in. Never commit the real file.

# --- required -------------------------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Your hosted PostgreSQL. With several app copies use the database's POOLED endpoint (Neon: the host with "-pooler" in it),
# otherwise every copy opens its own connections and the database runs out of them.
DATABASE_URL=postgresql://user:password@host-pooler.example.neon.tech/dbname?sslmode=require
APP_ENV=production

# --- your site -------------------------------------------------------------------------------------------------------
SITE_HOSTS=www.example.com                 # the domain visitors use (localhost is always added)
CSRF_TRUSTED_ORIGINS=https://www.example.com
# When the balancer is reached over plain HTTP (a trial on your own PC) turn the HTTPS redirect off:
# SECURE_SSL_REDIRECT=false

# --- everything else the app already uses (email, Google Drive, ...) goes here too, same names as backend/.env.example -----

# --- capacity knobs (all optional) ----------------------------------------------------------------------------------------
APP_REPLICAS=2              # app copies started by a plain `docker compose up` (or use --scale app=N)
WEB_CONCURRENCY=2           # worker processes per copy: about the CPU cores each copy gets
GUNICORN_THREADS=4          # requests one worker handles at the same time
LB_PORT=8080                # the port the balancer listens on

# --- balancer protection -----------------------------------------------------------------------------------------------
RATE_PER_10S=300            # requests one address may make in 10 seconds before it gets "429 Too many requests"
AUTH_POSTS_PER_MIN=20       # sign-in / sign-up / OTP / reset POSTs one address may make per minute
BEHIND_CLOUDFLARE=0         # 1 when Cloudflare is in front (then ONLY allow Cloudflare's addresses to reach this machine)
